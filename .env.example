# Environment Configuration
PROJECT_NAME="Automated Essay Scoring"
ENVIRONMENT="development"
DEBUG=True

# Backend Service
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_secure_random_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="aes_user"
POSTGRES_PASSWORD="aes_password"
POSTGRES_DB="aes_db"
DATABASE_URL="postgresql+asyncpg://aes_user:aes_password@localhost:5432/aes_db"
DATABASE_SYNC_URL="postgresql://aes_user:aes_password@localhost:5432/aes_db"

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="essay-documents"
S3_REGION="us-east-1"

# Inference Worker & Model Configuration
MODEL_VERSION="aes-bert-v1.0"
MODEL_BASE_NAME="bert-base-uncased"
INFERENCE_DEVICE="cuda"  # or "cpu"
CONFIDENCE_THRESHOLD=0.75
BATCH_SIZE=8
WORKER_POLL_INTERVAL=2.0

# Frontend Service
VITE_API_BASE_URL="http://localhost:8000/api/v1"
